module cybercalc

go 1.27.1

// Единственная сторонняя зависимость во всём проекте — драйвер PostgreSQL.
// Стандартная библиотека database/sql не умеет говорить по проводному протоколу
// Postgres сама по себе, поэтому driver необходим; ORM, роутеры, фреймворки,
// библиотеки хеширования и т.п. сознательно не используются — везде stdlib.
require github.com/lib/pq v1.12.3
