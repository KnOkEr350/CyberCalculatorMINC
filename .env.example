# Рекомендуется bash scripts/init-env.sh: создаёт .env с уникальными паролями.
# Значения ниже — шаблон, не готовые production-секреты.
APP_ENV=development

DB_USER=cybercalc
DB_PASSWORD=
DB_NAME=cybercalc
DB_RUNTIME_USER=cybercalc_app
DB_RUNTIME_PASSWORD=

HTTP_PORT=8080
HTTP_BIND=127.0.0.1
BACKEND_REPLICAS=2

# Учётная запись первого администратора создаётся автоматически при первом
# запуске, если в БД ещё нет ни одного admin. Смените пароль сразу после
# первого входа (кнопка «Пароль» в верхней панели).
ADMIN_BOOTSTRAP_EMAIL=admin@minc.local
ADMIN_BOOTSTRAP_PASSWORD=
PUBLIC_URL=
CLAMAV_ADDRESS=
MFA_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
UPLOAD_QUOTA_BYTES=1073741824

# Необязательно: HTTPS-ссылка официального домена на нормализованную XLSX-
# выгрузку по шаблону из раздела «Учебные заведения». При наличии backend
# проверяет и обновляет справочник сразу после запуска и затем по расписанию.
DIRECTORY_SYNC_URL=
DIRECTORY_SYNC_INTERVAL_HOURS=24
