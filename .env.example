# Скопируйте в .env и при необходимости отредактируйте перед первым запуском.

DB_USER=cybercalc
DB_PASSWORD=change_me_db_password
DB_NAME=cybercalc

HTTP_PORT=8080
BACKEND_REPLICAS=2

# Учётная запись первого администратора создаётся автоматически при первом
# запуске, если в БД ещё нет ни одного admin. Смените пароль сразу после
# первого входа (админка -> пользователи).
ADMIN_BOOTSTRAP_EMAIL=admin@minc.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
