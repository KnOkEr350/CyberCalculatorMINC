# Install on the HOST nginx, outside Docker. Replace domain and certificate
# paths. Docker's HTTP port is bound to loopback only.
server {
    listen 80;
    server_name calculator.example.org;
    return 308 https://calculator.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name calculator.example.org;
    ssl_certificate /etc/letsencrypt/live/calculator.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/calculator.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 65m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
